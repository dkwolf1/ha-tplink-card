{
  "name": "ha-tplink-card",
  "version": "1.8.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:md": "markdownlint-cli2",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "node scripts/package.mjs build",
    "validate": "node scripts/package.mjs",
    "test": "node --test tests/card.test.cjs",
    "test:browser": "playwright test",
    "demo": "node scripts/serve.mjs",
    "screenshots": "playwright test --grep @screenshots",
    "check": "npm run lint && npm run lint:md && npm run format:check && npm run validate && npm test"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "markdownlint-cli2": "0.24.2",
    "prettier": "3.10.1"
  },
  "overrides": {
    "micromark-extension-math": {
      "katex": "0.19.1"
    }
  }
}
